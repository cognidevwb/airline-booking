{
  "id": "post-booking-last-free-seat-on-the-fligh",
  "title": "Last free seat on the flight",
  "source": "staged scenario",
  "why": "Tests the capacity boundary when exactly one seat remains",
  "setup": [
    {
      "ref": "flight-1",
      "table": "Trip",
      "values": {
        "AircraftId": "aa000000-0000-4000-8000-000000000001",
        "ArriveAirportId": "ea000000-0000-4000-8000-000000000001",
        "DepartureAirportId": "da000000-0000-4000-8000-000000000001",
        "Description": "One seat left",
        "FlightDate": "2026-12-22T15:30:00Z",
        "FlightNumber": "QF12",
        "Price": 340.0,
        "SeatNumber": "30K"
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST …/booking for a valid passenger on flight-1, which has all other seats booked"
    }
  ],
  "expect": [
    "Booking succeeds and takes seat 30K; the flight is then full"
  ]
}
