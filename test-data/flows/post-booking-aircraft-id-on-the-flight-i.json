{
  "id": "post-booking-aircraft-id-on-the-flight-i",
  "title": "Aircraft id on the flight is invalid",
  "source": "staged scenario",
  "why": "Shows bad aircraft data on the flight blocks booking",
  "setup": [
    {
      "ref": "flight-1",
      "table": "Trip",
      "values": {
        "AircraftId": "00000000-0000-0000-0000-000000000000",
        "ArriveAirportId": "ee000000-0000-4000-8000-000000000001",
        "DepartureAirportId": "de000000-0000-4000-8000-000000000001",
        "Description": "Bad aircraft",
        "FlightDate": "2027-01-15T09:00:00Z",
        "FlightNumber": "VS45",
        "Price": 200.0,
        "SeatNumber": "11A"
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "POST …/booking for a valid passenger on flight-1"
    }
  ],
  "expect": [
    "Booking is rejected with an invalid aircraft id error; no booking is created"
  ]
}
